# Copy to .env.local and fill in your own values. Never commit credentials.
# Use the pooled PostgreSQL connection string from your Neon project's Connect dialog.
DATABASE_URL="postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

